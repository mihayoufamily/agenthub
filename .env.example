# AgentHub 不要求任何环境变量即可运行。以下仅列出可选的开发/兼容性变量。

# 兼容模式：禁用 Chromium 沙箱（部分安全软件会拦截 Electron 沙箱子进程导致崩溃时使用）
# 正常机器无需设置
AGENTHUB_NO_SANDBOX=1

# electron 二进制下载镜像（仅 npm install 阶段使用，国内网络推荐）
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/

# 开发：指向 vite/rollup 产物目录的热更新服务（当前 dev 流程为"构建后运行"，未使用）
# VITE_DEV_SERVER_URL=http://localhost:5173
