{
  "name": "agenthub",
  "productName": "AgentHub",
  "version": "0.2.1",
  "description": "AgentHub — 多 Agent 工作台与工作流协作桌面应用（Windows）",
  "main": "./out/main/index.js",
  "author": "AgentHub",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:main": "tsc -p tsconfig.build-main.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "test:e2e": "node tests/e2e/local.mjs",
    "pack:portable": "node scripts/pack-portable.mjs",
    "push:api": "node scripts/push-via-api.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "37.10.3",
    "electron-builder": "^24.13.3",
    "rollup": "^3.4.0",
    "typescript": "^5.5.4"
  }
}
